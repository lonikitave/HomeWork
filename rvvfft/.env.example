# rvvfft multi-agent collaboration environment configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.
#
# Supported models (choose one):
#   gpt-4o
#   gpt-4o-mini
#   gpt-4-turbo
#   gpt-4
#   gpt-3.5-turbo
#
# NOTE: "GPT-5.3-Codex" is not a valid OpenAI model name.
# Use one of the models listed above instead.

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

{#
  butterfly.c.j2 — Jinja2 template for RVV intrinsic butterfly kernels
  
  Context variables provided by generator.py:
    func_name   : C function name (e.g. rvvfft_butterfly_r2_f32_vlen256)
    radix       : int (2, 4, 8, …)
    dtype       : 'f32' or 'f64'
    vlen        : int (256 or 1024)
    lmul        : int (1, 2, 4, 8)
    layout      : 'interleaved' or 'split'
    sew         : int (32 for f32, 64 for f64)
    vl_max      : int = vlen / sew  (elements per vector register group)
    operations  : list of dicts, each describing one scalar instruction to emit
                  in the vectorised loop body (produced by generator.py)
    timestamp   : ISO-8601 generation timestamp
    generator_version : str
#}
/**
 * {{ func_name }}.c
 *
 * AUTO-GENERATED by rvvfft codegen {{ generator_version }} — DO NOT EDIT.
 * Generated: {{ timestamp }}
 *
 * Butterfly kernel: radix={{ radix }}, dtype={{ dtype }},
 *                   vlen={{ vlen }}, lmul={{ lmul }},
 *                   layout={{ layout }}
 *
 * Mathematical correctness verified by verify_math.py (SymPy).
 * This file is produced from template butterfly.c.j2.
 */

#include <riscv_vector.h>
#include <stddef.h>
#include "rvvfft_types.h"

/* ── Compile-time sanity check ─────────────────────────────────────────────── */
#ifndef __riscv_v
#  error "RVV (RISC-V Vector Extension) is required. Compile with -march=rv64gcv."
#endif

{% if dtype == 'f32' %}
typedef float  scalar_t;
typedef vfloat32m{{ lmul }}_t vec_t;
#define VLE_F  vle32_v_f32m{{ lmul }}
#define VSE_F  vse32_v_f32m{{ lmul }}
#define VFADD  vfadd_vv_f32m{{ lmul }}
#define VFSUB  vfsub_vv_f32m{{ lmul }}
#define VFMUL  vfmul_vv_f32m{{ lmul }}
#define VFMACC vfmacc_vv_f32m{{ lmul }}
#define VFNMSAC vfnmsac_vv_f32m{{ lmul }}
#define VFNEG  vfneg_v_f32m{{ lmul }}
{% else %}
typedef double scalar_t;
typedef vfloat64m{{ lmul }}_t vec_t;
#define VLE_F  vle64_v_f64m{{ lmul }}
#define VSE_F  vse64_v_f64m{{ lmul }}
#define VFADD  vfadd_vv_f64m{{ lmul }}
#define VFSUB  vfsub_vv_f64m{{ lmul }}
#define VFMUL  vfmul_vv_f64m{{ lmul }}
#define VFMACC vfmacc_vv_f64m{{ lmul }}
#define VFNMSAC vfnmsac_vv_f64m{{ lmul }}
#define VFNEG  vfneg_v_f64m{{ lmul }}
{% endif %}

/* Max vector length for this VLEN / SEW / LMUL combination */
#define VL_MAX {{ vl_max }}

/**
 * {{ func_name }}
 *
{% if layout == 'interleaved' %}
 * @in:     Input  buffer — interleaved [r0,i0,r1,i1,...], {{ radix }}*n elements.
 * @out:    Output buffer — same layout, may equal @in (in-place).
{% else %}
 * @in_r:   Input  real  part, n elements.
 * @in_i:   Input  imag  part, n elements.
 * @out_r:  Output real  part (may equal @in_r for in-place).
 * @out_i:  Output imag  part (may equal @in_i for in-place).
{% endif %}
 * @n:      Number of {{ radix }}-point butterfly groups to process.
 * @tw_r:   Twiddle factor real  parts table (at least {{ radix - 1 }}*n entries).
 * @tw_i:   Twiddle factor imag  parts table (at least {{ radix - 1 }}*n entries).
 */
void {{ func_name }}(
{% if layout == 'interleaved' %}
    const scalar_t * __restrict__ in,
          scalar_t * __restrict__ out,
{% else %}
    const scalar_t * __restrict__ in_r,
    const scalar_t * __restrict__ in_i,
          scalar_t * __restrict__ out_r,
          scalar_t * __restrict__ out_i,
{% endif %}
    size_t n,
    const scalar_t * __restrict__ tw_r,
    const scalar_t * __restrict__ tw_i)
{
    size_t avl = n;

    while (avl > 0) {
        /* Set vector length — tail-undisturbed for partial last group */
        size_t vl = __riscv_vsetvl_e{{ sew }}m{{ lmul }}(avl);

        /* ── Load input elements ──────────────────────────────────────── */
{% if layout == 'split' %}
        vec_t x0_r = VLE_F(in_r, vl);
        vec_t x0_i = VLE_F(in_i, vl);
{% for k in range(1, radix) %}
        vec_t x{{ k }}_r = VLE_F(in_r + {{ k }} * n, vl);
        vec_t x{{ k }}_i = VLE_F(in_i + {{ k }} * n, vl);
{% endfor %}
{% else %}
        /* Interleaved: stride-2 load to separate real/imag */
        vec_t x0_r = __riscv_vlse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(in,     2 * sizeof(scalar_t), vl);
        vec_t x0_i = __riscv_vlse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(in + 1, 2 * sizeof(scalar_t), vl);
{% for k in range(1, radix) %}
        vec_t x{{ k }}_r = __riscv_vlse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(in + {{ 2*k }},     2 * sizeof(scalar_t), vl);
        vec_t x{{ k }}_i = __riscv_vlse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(in + {{ 2*k }} + 1, 2 * sizeof(scalar_t), vl);
{% endfor %}
{% endif %}

        /* ── Load twiddle factors ─────────────────────────────────────── */
{% for k in range(1, radix) %}
        vec_t tw{{ k }}_r = VLE_F(tw_r + {{ k - 1 }} * n, vl);
        vec_t tw{{ k }}_i = VLE_F(tw_i + {{ k - 1 }} * n, vl);
{% endfor %}

        /* ── Butterfly computation ────────────────────────────────────── */
        /* Apply twiddle: xt[k] = x[k] * (tw_r + j*tw_i)                */
        /*   xt_r = x_r * tw_r - x_i * tw_i  (vfmul + vfnmsac)         */
        /*   xt_i = x_r * tw_i + x_i * tw_r  (vfmul + vfmacc)           */
{% for k in range(1, radix) %}
        vec_t xt{{ k }}_r = VFNMSAC(VFMUL(x{{ k }}_r, tw{{ k }}_r, vl), x{{ k }}_i, tw{{ k }}_i, vl);
        vec_t xt{{ k }}_i = VFMACC( VFMUL(x{{ k }}_r, tw{{ k }}_i, vl), x{{ k }}_i, tw{{ k }}_r, vl);
{% endfor %}

{% if radix == 2 %}
        /* radix-2 butterfly */
        vec_t out0_r = VFADD(x0_r, xt1_r, vl);
        vec_t out0_i = VFADD(x0_i, xt1_i, vl);
        vec_t out1_r = VFSUB(x0_r, xt1_r, vl);
        vec_t out1_i = VFSUB(x0_i, xt1_i, vl);

{% elif radix == 4 %}
        /* radix-4 butterfly — DIT */
        /* Stage 1 */
        vec_t a0_r = VFADD(x0_r,  xt2_r, vl);
        vec_t a0_i = VFADD(x0_i,  xt2_i, vl);
        vec_t a1_r = VFSUB(x0_r,  xt2_r, vl);
        vec_t a1_i = VFSUB(x0_i,  xt2_i, vl);
        vec_t a2_r = VFADD(xt1_r, xt3_r, vl);
        vec_t a2_i = VFADD(xt1_i, xt3_i, vl);
        /* Multiply (xt1-xt3) by -j: (r,i) → (i,-r) */
        vec_t d_r  = VFSUB(xt1_r, xt3_r, vl);
        vec_t d_i  = VFSUB(xt1_i, xt3_i, vl);
        vec_t a3_r = d_i;
        vec_t a3_i = VFNEG(d_r, vl);
        /* Stage 2 */
        vec_t out0_r = VFADD(a0_r, a2_r, vl);
        vec_t out0_i = VFADD(a0_i, a2_i, vl);
        vec_t out1_r = VFADD(a1_r, a3_r, vl);
        vec_t out1_i = VFADD(a1_i, a3_i, vl);
        vec_t out2_r = VFSUB(a0_r, a2_r, vl);
        vec_t out2_i = VFSUB(a0_i, a2_i, vl);
        vec_t out3_r = VFSUB(a1_r, a3_r, vl);
        vec_t out3_i = VFSUB(a1_i, a3_i, vl);

{% elif radix == 8 %}
        /* radix-8 butterfly — see dag.py build_radix8_butterfly() */
        /* Stage 1: stride-4 butterflies */
        vec_t s0_r = VFADD(x0_r,  xt4_r, vl);  vec_t s0_i = VFADD(x0_i,  xt4_i, vl);
        vec_t s4_r = VFSUB(x0_r,  xt4_r, vl);  vec_t s4_i = VFSUB(x0_i,  xt4_i, vl);
        vec_t s1_r = VFADD(xt1_r, xt5_r, vl);  vec_t s1_i = VFADD(xt1_i, xt5_i, vl);
        vec_t s5_r = VFSUB(xt1_r, xt5_r, vl);  vec_t s5_i = VFSUB(xt1_i, xt5_i, vl);
        vec_t s2_r = VFADD(xt2_r, xt6_r, vl);  vec_t s2_i = VFADD(xt2_i, xt6_i, vl);
        vec_t s6_r = VFSUB(xt2_r, xt6_r, vl);  vec_t s6_i = VFSUB(xt2_i, xt6_i, vl);
        vec_t s3_r = VFADD(xt3_r, xt7_r, vl);  vec_t s3_i = VFADD(xt3_i, xt7_i, vl);
        vec_t s7_r = VFSUB(xt3_r, xt7_r, vl);  vec_t s7_i = VFSUB(xt3_i, xt7_i, vl);

        /* Stage 2: sub-problem A (even positions, twiddles already applied) */
        vec_t t0A_r = VFADD(s0_r, s2_r, vl);  vec_t t0A_i = VFADD(s0_i, s2_i, vl);
        vec_t t2A_r = VFSUB(s0_r, s2_r, vl);  vec_t t2A_i = VFSUB(s0_i, s2_i, vl);
        vec_t t1A_r = VFADD(s1_r, s3_r, vl);  vec_t t1A_i = VFADD(s1_i, s3_i, vl);
        vec_t d3A_r = VFSUB(s1_r, s3_r, vl);  vec_t d3A_i = VFSUB(s1_i, s3_i, vl);
        vec_t t3A_r = d3A_i;                   vec_t t3A_i = VFNEG(d3A_r, vl);
        vec_t out0_r = VFADD(t0A_r, t1A_r, vl); vec_t out0_i = VFADD(t0A_i, t1A_i, vl);
        vec_t out2_r = VFSUB(t0A_r, t1A_r, vl); vec_t out2_i = VFSUB(t0A_i, t1A_i, vl);
        vec_t out4_r = VFADD(t2A_r, t3A_r, vl); vec_t out4_i = VFADD(t2A_i, t3A_i, vl);
        vec_t out6_r = VFSUB(t2A_r, t3A_r, vl); vec_t out6_i = VFSUB(t2A_i, t3A_i, vl);

        /* Stage 2: sub-problem B (odd positions, needs additional twiddles W^1,W^2,W^3) */
        /* These twiddles are included in the tw_r/tw_i tables by the planner */
        vec_t t0B_r = VFADD(s4_r, s6_r, vl);  vec_t t0B_i = VFADD(s4_i, s6_i, vl);
        vec_t t2B_r = VFSUB(s4_r, s6_r, vl);  vec_t t2B_i = VFSUB(s4_i, s6_i, vl);
        vec_t t1B_r = VFADD(s5_r, s7_r, vl);  vec_t t1B_i = VFADD(s5_i, s7_i, vl);
        vec_t d3B_r = VFSUB(s5_r, s7_r, vl);  vec_t d3B_i = VFSUB(s5_i, s7_i, vl);
        vec_t t3B_r = d3B_i;                   vec_t t3B_i = VFNEG(d3B_r, vl);
        vec_t out1_r = VFADD(t0B_r, t1B_r, vl); vec_t out1_i = VFADD(t0B_i, t1B_i, vl);
        vec_t out3_r = VFSUB(t0B_r, t1B_r, vl); vec_t out3_i = VFSUB(t0B_i, t1B_i, vl);
        vec_t out5_r = VFADD(t2B_r, t3B_r, vl); vec_t out5_i = VFADD(t2B_i, t3B_i, vl);
        vec_t out7_r = VFSUB(t2B_r, t3B_r, vl); vec_t out7_i = VFSUB(t2B_i, t3B_i, vl);
{% endif %}

        /* ── Store outputs ────────────────────────────────────────────── */
{% if layout == 'split' %}
{% for k in range(radix) %}
        VSE_F(out_r + {{ k }} * n, out{{ k }}_r, vl);
        VSE_F(out_i + {{ k }} * n, out{{ k }}_i, vl);
{% endfor %}
{% else %}
{% for k in range(radix) %}
        __riscv_vsse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(out + {{ 2*k }},     2 * sizeof(scalar_t), out{{ k }}_r, vl);
        __riscv_vsse{{ sew }}_v_{{ 'f32' if sew==32 else 'f64' }}m{{ lmul }}(out + {{ 2*k }} + 1, 2 * sizeof(scalar_t), out{{ k }}_i, vl);
{% endfor %}
{% endif %}

        /* Advance pointers */
        avl -= vl;
{% if layout == 'split' %}
        in_r  += vl;  in_i  += vl;
        out_r += vl;  out_i += vl;
{% else %}
        in  += 2 * vl;
        out += 2 * vl;
{% endif %}
        tw_r += vl;
        tw_i += vl;
    }
}

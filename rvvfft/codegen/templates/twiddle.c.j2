/**
 * {{ func_name }} — Fill twiddle factor tables for a length-n, stage-s FFT pass.
 *
 * Computes W^k_N = cos(-2π k/n) + j * sin(-2π k/n) for k = 0 .. count-1.
 *
 * @tw_r:   Output: real  parts of twiddle factors (count entries).
 * @tw_i:   Output: imag  parts of twiddle factors (count entries).
 * @n:      Full transform length.
 * @stride: Step between twiddle indices (= n / radix for each stage).
 * @count:  Number of twiddle entries to fill.
 */
void {{ func_name }}(scalar_t * __restrict__ tw_r,
                     scalar_t * __restrict__ tw_i,
                     int n, int stride, int count)
{
